{
  "name": "entrelinhas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/contracts",
    "packages/api-client",
    "apps/frontend"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "node --test scripts/coverage/check-coverage.test.mjs scripts/workspaces/check-workspaces.test.mjs",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "build": "npm run build -w apps/frontend",
    "e2e": "playwright test",
    "verify": "npm run check:workspaces && npm run lint && npm run typecheck && npm run test:scripts && npm run test:coverage && npm run build && npm run e2e",
    "check:workspaces": "node scripts/workspaces/check-workspaces.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
