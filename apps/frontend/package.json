{
  "name": "@entrelinhas/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode mock",
    "build": "tsc --noEmit -p . && vite build && node ../../scripts/bundle/check-no-mocks.mjs dist",
    "preview": "vite preview --outDir dist-mock",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node ../../scripts/coverage/check-coverage.mjs --report coverage/coverage-final.json --src src",
    "build:mock": "vite build --mode mock --outDir dist-mock"
  },
  "dependencies": {
    "@fontsource/poppins": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "@entrelinhas/api-client": "*",
    "@entrelinhas/contracts": "*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "vite": "8.3.5"
  }
}
